{% extends 'base.html.twig' %}

{% block title %}{{ anime.title }}{% endblock %}

{% block body %}
<div class="anime-detail">
    <div class="card-poster">
        {% if anime.posterImage %}<img src="{{ anime.posterImage }}" alt="{{ anime.title }}">{% endif %}
    </div>

    <div>
        <span class="eyebrow">{{ anime.studio ? anime.studio.name : 'Studio inconnu' }}</span>
        <h1>{{ anime.title }}</h1>
        {% if anime.createdBy %}<p class="muted">Fiche ajoutée par <strong>{{ anime.createdBy.pseudo }}</strong></p>{% endif %}

        {% if canEdit %}
            <div class="actions">
                <a class="btn btn-outline" href="{{ path('app_anime_edit', {id: anime.id}) }}">Modifier la fiche</a>
                <form class="inline" method="post" action="{{ path('app_anime_delete', {id: anime.id}) }}" onsubmit="return confirm('Supprimer cette fiche ?')">
                    <button class="btn-outline">Supprimer</button>
                </form>
            </div>
        {% endif %}

        <ul class="info-list">
            <li>Année : <strong>{{ anime.releaseYear ?? '?' }}</strong></li>
            <li>Épisodes : <strong>{{ anime.episodesCount ?? '?' }}</strong></li>
            <li>Genres :
                {% for genre in anime.genres %}{{ genre.name }}{{ not loop.last ? ', ' }}{% else %}-{% endfor %}
            </li>
            <li>Note moyenne :
                <strong>{{ average is not null ? average|number_format(1) ~ '/10 (' ~ reviews|length ~ ' avis)' : 'pas encore noté' }}</strong>
            </li>
        </ul>
        <p>{{ anime.synopsis|nl2br }}</p>
    </div>
</div>

<div class="panel">
    <h2>Notes</h2>
    {% if app.user %}
        <form method="post" action="{{ path('app_anime_review', {id: anime.id}) }}">
            <label>Ta note (1-10) : <input type="number" name="rating" min="1" max="10" required></label><br><br>
            <textarea name="comment" rows="3" placeholder="Un commentaire (facultatif)"></textarea><br>
            <button>Noter</button>
        </form>
    {% else %}
        <p><a class="rating" href="{{ path('app_login') }}">Connecte-toi</a> pour noter cet anime.</p>
    {% endif %}

    {% for review in reviews %}
        <div class="review">
            <strong>{{ review.user.pseudo }}</strong> · <span class="rating">{{ review.rating }}/10</span>
            {% if review.comment %}<p>{{ review.comment|nl2br }}</p>{% endif %}
        </div>
    {% else %}
        <p class="muted">Aucune note pour l'instant.</p>
    {% endfor %}
</div>
{% endblock %}
