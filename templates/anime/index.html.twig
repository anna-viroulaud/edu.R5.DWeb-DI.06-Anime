{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
<h1>Tous les animes</h1>
<form method="get">
    <select name="genre">
        <option value="">Tous les genres</option>
        {% for genre in genres %}
            <option value="{{ genre.id }}" {{ genre.id == currentGenre ? 'selected' }}>{{ genre.name }}</option>
        {% endfor %}
    </select>
    <select name="studio">
        <option value="">Tous les studios</option>
        {% for studio in studios %}
            <option value="{{ studio.id }}" {{ studio.id == currentStudio ? 'selected' }}>{{ studio.name }}</option>
        {% endfor %}
    </select>
    <select name="year">
        <option value="">Toutes les années</option>
        {% for year in years %}
            <option value="{{ year }}" {{ year == currentYear ? 'selected' }}>{{ year }}</option>
        {% endfor %}
    </select>
    <button>Filtrer</button>
</form>
<div class="grid">
    {% for anime in animes %}{% include 'anime/_card.html.twig' %}{% else %}<p>Aucun anime.</p>{% endfor %}
</div>
{% endblock %}
